// Euclid GCD
fn gcd(a, b) {
  while (b != 0) {
    let t = b;
    b = a % b;
    a = t;
  };
  a
};

// fast (a^e) mod m
fn pow_mod(a, e, m) {
  let res = 1;
  let base = a % m;
  while (e > 0) {
    if (e % 2 == 1) { res = (res * base) % m; };
    base = (base * base) % m;
    e = e / 2;
  };
  res
};

// multiplicative order of a mod n (assumes gcd(a,n)==1)
fn findOrder(a, n) {
  let y = 1;
  let t = pow_mod(a, y, n);
  while (t != 1) {
    y = y + 1;
    t = pow_mod(a, y, n);
  };
  y
};

// classical Shor post-processing (trial a)
fn shor(x) {
  if (x % 2 == 0) { return "[ " + 2 + ", " + (x/2) + " ]"; };

  let a = 2;
  while (a < x) {
    let d = gcd(a, x);
    if (d > 1 && d < x) { return "[ " + d + ", " + (x/d) + " ]"; };

    if (d == 1) {
      let r = findOrder(a, x);
      if (r % 2 == 0) {
        let ar2 = pow_mod(a, r/2, x);         // a^(r/2) mod x
        if (ar2 != x - 1) {               // not -1 mod x
          let p = gcd(ar2 + 1, x);
          let q = gcd(ar2 - 1, x);
          if (p*q == x && p > 1 && q > 1) { 
            return "[ " + p + ", " + q + " ]"; 
          };
        };
      };
    };
    a = a + 1;
  };
};

// smoke tests
let x = 21; 
let y = 49;
print("gcd("+x+","+y+") = " + gcd(x,y));
print("shor(15) = " + shor(15));
assert(gcd(15, 21) == 3);
assert(shor(15) == "[ 5, 3 ]");
